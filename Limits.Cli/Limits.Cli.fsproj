<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>limits</AssemblyName>
    <RootNamespace>Limits.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>limits</ToolCommandName>
    <PackageId>limits-cli</PackageId>
    <Version>1.0.2</Version>
    <Description>Cross-platform CLI tool for monitoring AI provider quotas and usage limits (OpenAI, Claude, Gemini, Antigravity, Cursor, DeepSeek, OpenRouter, ElevenLabs, Groq, AWS Bedrock).</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Limits.Core\Limits.Core.fsproj" />
  </ItemGroup>

</Project>
