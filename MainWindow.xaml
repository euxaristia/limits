<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CodexBarWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CodexBarWin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CodexBar"
    mc:Ignorable="d">
    
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="#C018181A" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <Grid Grid.Row="0" Padding="16,16,16,12" BorderBrush="#2D2D30" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEC7A;" FontFamily="Segoe MDL2 Assets" Foreground="#FF16D3B4" FontSize="18" />
                <TextBlock Text="CodexBar" FontWeight="SemiBold" FontSize="16" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
                <Border CornerRadius="4" Background="#3E3E42" Padding="6,2" Margin="4,0,0,0">
                    <TextBlock Text="F# Core" FontSize="10" Foreground="#FF16D3B4" FontWeight="Bold" />
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="12">
                <Button x:Name="RefreshButton" Click="RefreshButton_Click" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" ToolTipService.ToolTip="Refresh stats">
                    <FontIcon Glyph="&#xE149;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFB0B0B5" />
                </Button>
                <Button x:Name="SettingsButton" Click="SettingsButton_Click" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" ToolTipService.ToolTip="Providers &amp; API Keys">
                    <FontIcon Glyph="&#xE115;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFB0B0B5" />
                </Button>
                <Button x:Name="ExitButton" Click="ExitButton_Click" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" ToolTipService.ToolTip="Quit application">
                    <FontIcon Glyph="&#xE106;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFEF4444" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- 1. Dashboard Panel -->
            <ScrollViewer x:Name="DashboardPanel" Visibility="Visible" Padding="16,8,16,16" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock Text="ACTIVE PROVIDERS" FontSize="10" FontWeight="Bold" Foreground="#FF8B8B90" CharacterSpacing="60" Margin="0,8,0,4" />
                    
                    <ItemsControl x:Name="ProvidersItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ProviderViewModel">
                                <Border Margin="0,0,0,12" Background="#1D1D20" CornerRadius="8" Padding="12" BorderBrush="#2D2D30" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Row 1: Title, Status Badge, Percent -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <!-- Status indicator circle -->
                                                <Ellipse Width="8" Height="8" Fill="{x:Bind StatusBrush, Mode=OneTime}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFFFF" />
                                                <Border CornerRadius="4" Background="#2A2A2E" Padding="4,1" Visibility="{x:Bind IsMockVisibility, Mode=OneTime}">
                                                    <TextBlock Text="MOCK" FontSize="8" Foreground="#FF8B8B90" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            
                                            <TextBlock Grid.Column="1" Text="{x:Bind PercentText, Mode=OneTime}" FontSize="12" Foreground="#FF8B8B90" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                        
                                        <!-- Row 2: Custom Gradient Progress Bar -->
                                        <Grid Grid.Row="1" Height="6" CornerRadius="3" Background="#28282B" Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind UsedStarWidth, Mode=OneTime}" />
                                                <ColumnDefinition Width="{x:Bind RemainingStarWidth, Mode=OneTime}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="3" Background="{x:Bind ProgressBarBrush, Mode=OneTime}" />
                                        </Grid>
                                        
                                        <!-- Row 3: Usage, Limit, Countdown -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" Text="{x:Bind CostInfo, Mode=OneTime}" FontSize="11" Foreground="#FFB0B0B5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ResetCountdown, Mode=OneTime}" FontSize="10" Foreground="#FF8B8B90" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 2. Settings Panel -->
            <Grid x:Name="SettingsPanel" Visibility="Collapsed" Padding="16,12,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Click="CancelSettings_Click" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE112;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" Text="Settings" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#FF16D3B4" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="API PROVIDERS" FontSize="10" FontWeight="Bold" Foreground="#FF8B8B90" CharacterSpacing="60" />

                        <ItemsControl x:Name="SettingsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ProviderSettingItem">
                                    <Border Margin="0,0,0,12" Background="#1D1D20" CornerRadius="8" Padding="12" BorderBrush="#2D2D30" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                                            </Grid>
                                            
                                            <!-- API Key text box, visible only when enabled -->
                                            <TextBox Header="API Key" 
                                                     Text="{x:Bind ApiKey, Mode=TwoWay}"
                                                     PlaceholderText="sk-..." 
                                                     Visibility="{x:Bind IsEnabled, Mode=OneWay}" 
                                                     FontSize="11" 
                                                     Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancel" Click="CancelSettings_Click" HorizontalAlignment="Stretch" Margin="0,0,6,0" Style="{StaticResource DefaultButtonStyle}" />
                    <Button Grid.Column="1" Content="Save Config" Click="SaveSettings_Click" HorizontalAlignment="Stretch" Margin="6,0,0,0" Style="{StaticResource AccentButtonStyle}" Background="#FF16D3B4" Foreground="Black" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" Padding="16,10,16,12" Background="#161618" BorderBrush="#2D2D30" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <!-- Link to config.json -->
            <HyperlinkButton Grid.Column="0" Click="ConfigLink_Click" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FF8B8B90" />
                    <TextBlock Text="config.json" FontSize="11" Foreground="#FF8B8B90" />
                </StackPanel>
            </HyperlinkButton>

            <TextBlock Grid.Column="1" Text="v1.0.0 (WinUI 3)" FontSize="10" Foreground="#FF5A5A60" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
